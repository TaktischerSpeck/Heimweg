{
  "name": "heimweg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.js",
    "secrets": "node scripts/secrets.js",
    "backup:encrypt": "node scripts/backup.js encrypt",
    "backup:decrypt": "node scripts/backup.js decrypt"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  }
}
