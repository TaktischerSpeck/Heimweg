# Public HTTPS origin, without a trailing slash or path.
APP_ORIGIN=https://heimweg.example.org
APP_PORT=3000
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# postgres | mariadb; DB_* values override the legacy PG* configuration.
# For an external MariaDB set DB_HOST to its hostname and DB_PORT=3306.
DB_ENGINE=postgres
# DB_HOST=db.example.org
# DB_PORT=3306
# DB_NAME=heimweg
# DB_USER=heimweg
# DB_PASSWORD="replace-with-your-database-password"
# DB_SSL=true
# DB_SSL_CA_FILE=/private/path/to/database-ca.pem

# For native Node/Plesk (paths relative to the application working directory).
# Docker Compose supplies these secret paths automatically.
# ENCRYPTION_KEY_FILE=./secrets/encryption_key
# SETUP_TOKEN_FILE=./secrets/setup_token
# BACKUP_KEY_FILE=./secrets/backup_key

# PostgreSQL 18; use a separate database/user for this application.
PGHOST=db
PGPORT=5432
PGDATABASE=heimweg
PGUSER=heimweg
PGSSL=false

# disabled | self-hosted | external
PROVIDER_MODE=disabled
MAP_PROVIDER=osrm
OSRM_URL=
NOMINATIM_URL=
# Optional HTTP Basic authentication for own HTTPS services (credentials stay in Node).
# OSRM_URL=https://routing.example.org
# OSRM_USERNAME=heimweg
# OSRM_PASSWORD="replace-with-your-service-password"
# Alternatively: OSRM_PASSWORD_FILE=/private/path/osrm_password
# NOMINATIM_USERNAME=heimweg
# NOMINATIM_PASSWORD_FILE=/private/path/nominatim_password
ALLOW_EXTERNAL_LOCATION_DATA=false

# Optional hosted routing and address lookup, called only by the Node backend.
# MAP_PROVIDER=ors
# PROVIDER_MODE=external
# ALLOW_EXTERNAL_LOCATION_DATA=true
# ORS_URL=https://api.openrouteservice.org
# ORS_API_KEY="your-provider-api-key"

# Exact socket IP of the direct trusted reverse proxy, or empty.
# Configure the proxy to overwrite X-Real-IP; never forward an arbitrary client value.
TRUSTED_PROXY_IP=

# Background raster tiles: external (explicit per-session user consent), self-hosted, disabled.
# Road geometry always comes from the configured routing service through Node.
MAP_TILE_MODE=external
# Set true to load the background immediately when displaying a route map.
# External providers receive browser IP and map viewport without a separate click.
MAP_TILE_AUTO_LOAD=false
# Default external tiles: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# For your own public HTTPS tile endpoint:
# MAP_TILE_MODE=self-hosted
# MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
