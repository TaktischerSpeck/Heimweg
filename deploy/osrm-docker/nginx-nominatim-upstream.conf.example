# Add inside a separate EXISTING public HTTPS geocoding virtual host.
# Replace the LXC IP. Use the same CA as the OSRM upstream.
location / {
    access_log off;
    error_log /dev/null crit;
    proxy_pass https://192.0.2.20:4433;
    proxy_ssl_server_name on;
    proxy_ssl_name osrm.internal;
    proxy_ssl_trusted_certificate /etc/nginx/trust/osrm-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_set_header Host osrm.internal;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_cache off;
    proxy_buffering off;
}
